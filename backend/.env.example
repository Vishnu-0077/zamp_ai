# Export these variables in your shell; .env files are not loaded automatically.
OPENAI_API_KEY=
# Set an available model supporting native JSON schema output and temperature=0.
EXTRACTION_MODEL=
# Optional provider keys for gemini:<model-id> and groq:<model-id> entries.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=
# Optional handling of transient provider errors (429, 5xx, timeouts). Defaults: no retries, no fallback.
# EXTRACTION_FALLBACK_MODELS=model-b,model-c
# EXTRACTION_PROVIDER_RETRIES=3
# EXTRACTION_RETRY_BACKOFF_SECONDS=5
BACKEND_API_KEY=
REVIEWER_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PROCESSING_DB=backend/runtime/processing.sqlite3
# Explicitly trusted procurement master and policy (never expected outcomes).
PROCUREMENT_PATH=backend/procurement.json
WORKER_ENABLED=true

# Development only: clear cases, audit history and reservations on worker startup.
RESET_ON_START=false
