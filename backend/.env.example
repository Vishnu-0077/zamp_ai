# Export these variables in your shell; .env files are not loaded automatically.
# ./backend/start.sh sets all of this for local development.

BACKEND_API_KEY=dev-app-key

# Provider keys for gemini:<model-id> and groq:<model-id> entries.
# Missing keys only skip that provider's models.
GEMINI_API_KEY=
GROQ_API_KEY=

# Model chain. Models need native JSON-schema output and temperature=0.
EXTRACTION_MODEL=gemini:gemini-3.5-flash
EXTRACTION_FALLBACK_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-3-flash-preview,gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b
# Retries per model for transient errors (429, 5xx, timeouts).
EXTRACTION_PROVIDER_RETRIES=3
EXTRACTION_RETRY_BACKOFF_SECONDS=5

# Only for unprefixed model IDs (OpenAI or a compatible endpoint). Not used by default.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PROCESSING_DB=backend/runtime/processing.sqlite3
# APPROVED_EXPORT_PATH=backend/runtime/exports/approved_invoices.xlsx
# Explicitly trusted procurement master and policy (never expected outcomes).
PROCUREMENT_PATH=backend/procurement.json
# POs added from the dashboard (cleared on every reset).
# PO_UPLOADS_PATH=backend/runtime/uploaded_purchase_orders.json
WORKER_ENABLED=true

# Development only: clear cases, audit history, reservations on worker startup.
RESET_ON_START=true
